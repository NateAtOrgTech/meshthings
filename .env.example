# Copy to .env and edit. Nothing here is secret today, but .env is gitignored
# so that stays true as things are added.

# Serial path of the Meshtastic node. Required.
#   macOS: ls /dev/cu.usbmodem*
#   Linux: ls /dev/ttyUSB* /dev/ttyACM*
SERIAL_DEVICE=/dev/ttyUSB0

# Port for the local HTTP stats page
PORT=3000

# --- weather -----------------------------------------------------------------
# UDP port the Tempest station broadcasts on. 41234 is the WeatherFlow default.
WEATHER_STATION_PORT=41234

# --- directory and alerts ----------------------------------------------------
# SQLite file holding service listings and alert subscriptions. Created on first
# run; both things share it.
MESH_DB=mesh.db

# --- alerts ------------------------------------------------------------------
# IANA time zone for rendering alert expiry times
TIME_ZONE=America/New_York

# Decoder process emitting NOAA SAME headers on stdout. Site-specific: your SDR,
# your local weather radio frequency (162.400-162.550 MHz).
#
# LEAVING THIS UNSET MEANS NO ALERTS ARE EVER RECEIVED. Subscriptions still
# work, so nobody is told that nothing is being monitored. `receiver` reports it.
# SAME_DECODER_COMMAND=samedec
# SAME_DECODER_ARGS=--rate 22050 -
